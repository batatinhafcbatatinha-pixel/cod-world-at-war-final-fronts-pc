@echo off
rem Build ps2EntryRunner with the CoD:WaW Final Fronts recompiled sources (project\runner).
rem Regenerate sources first with: build\ps2recomp\ps2xRecomp\ps2_recomp.exe config\recomp.toml
rem
rem   build-game.cmd        runtime only + relink against the existing game-code library (minutes)
rem   build-game.cmd full   also recompile the ~80k generated functions (needed after regenerating
rem                         project\runner or changing data layout in runtime headers)
rem
rem The generated sources are grouped into project\runner-chunks (scripts\make_chunks.py) so CMake
rem sees ~2.5k files instead of ~80k. Do not edit this file while it is running.
setlocal
call "C:\Program Files (x86)\Microsoft Visual Studio\2022\BuildTools\VC\Auxiliary\Build\vcvars64.bat" >nul
if errorlevel 1 exit /b 1
set "GIT_CONFIG_COUNT=1"
set "GIT_CONFIG_KEY_0=core.longpaths"
set "GIT_CONFIG_VALUE_0=true"
set "RUNNER=%~dp0project\runner"
set "RUNNER=%RUNNER:\=/%"
set "CHUNKS=%~dp0project\runner-chunks"
set "CHUNKS_CM=%CHUNKS:\=/%"
set "GAMELIB=%~dp0build\game\ps2xRuntime\ps2_game_code.lib"
set "GAMELIB_CM=%GAMELIB:\=/%"
set "MODE=%~1"
if not exist "%GAMELIB%" set "MODE=full"
if /i not "%MODE%"=="full" goto fastcheck
python "%~dp0scripts\make_chunks.py" "%~dp0project\runner" "%CHUNKS%"
if errorlevel 1 exit /b 1
goto configure
:fastcheck
rem Configuring is only needed the first time; afterwards ninja re-runs CMake itself when needed.
rem Always reconfigure the shared extracted-files adapter.
:configure
cmake -S "%~dp0..\third_party\PS2Recomp" -B "%~dp0build\game" -DCMAKE_PROJECT_TOP_LEVEL_INCLUDES="%~dp0tools/port-installer/runtime/defer_runtime.cmake" -G Ninja -DCMAKE_BUILD_TYPE=Release -DPS2X_ENABLE_LTCG=OFF -DPS2X_FAST_LINK=ON "-DPS2X_RUNNER_DIR=%RUNNER%" "-DPS2X_GAME_CHUNK_DIR=%CHUNKS_CM%" "-DPS2X_GAME_LIB_PREBUILT=%GAMELIB_CM%"
if errorlevel 1 exit /b 1
:build
if /i not "%MODE%"=="full" goto exe
cmake --build "%~dp0build\game" --target ps2_game_code --parallel 12
if errorlevel 1 exit /b 1
:exe
cmake --build "%~dp0build\game" --target ps2EntryRunner --parallel 12
exit /b %errorlevel%
